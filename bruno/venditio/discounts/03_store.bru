meta {
  name: Store discounts
  type: http
  seq: 78
}

post {
  url: {{baseUrl}}/discounts
  body: json
  auth: inherit
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "discountable_type": "product",
    "discountable_id": 1,
    "name": "Fixed price product discount",
    "type": "fixed_price",
    "value": 49.9,
    "standalone": true,
    "starts_at": "2026-02-11 17:00:00"
  }
}

docs {
  summary:
  - Store discounts

  endpoint:
  - method: POST
  - path: /discounts

  query params:
  - none

  path params:
  - none

  body:
  - JSON payload.
  - Available fields:
  - discountable_type (allowed: product, product_category, product_collection, product_type, brand, user)
  - discountable_id
  - type (allowed: percentage, fixed, fixed_price; fixed_price requires discountable_type=product)
  - value
  - name
  - code
  - active
  - starts_at
  - ends_at
  - uses
  - max_uses
  - apply_to_cart_total
  - apply_once_per_cart
  - max_uses_per_user
  - one_per_user
  - free_shipping
  - minimum_order_total
  - priority
  - standalone
  - Note: when a discountable target is provided, `code` can be omitted and the backend auto-generates it.
  - Note: product-scoped discounts are saved with maximum priority.
}
