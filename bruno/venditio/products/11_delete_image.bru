meta {
  name: Delete product image
  type: http
  seq: 11
}

delete {
  url: {{baseUrl}}/products/:id-or-slug/images/:image-id
  body: none
  auth: inherit
}

params:path {
  id-or-slug:
  image-id:
}

headers {
  Accept: application/json
  Locale: {{locale}}
}

docs {
  summary:
  - Delete a product image by its unique backend-generated image id.

  endpoint:
  - method: DELETE
  - path: /products/:id-or-slug/images/:image-id

  path params:
  - id-or-slug: Use a canonical positive integer product ID, or any product slug. Leading-zero or mixed values (for example `001` or `01-slug`) resolve as slugs.
  - image-id: Unique image id returned in the product `images` array.

  behavior:
  - Removes the matching entry from the product `images` collection.
  - Returns `204 No Content` on success.
  - Filesystem deletion is controlled by `VENDITIO_CATALOG_IMAGE_DELETE_FILES_FROM_FILESYSTEM`.
}
