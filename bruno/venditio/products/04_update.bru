meta {
  name: Update products
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/products/:id-or-slug
  body: json
  auth: inherit
}

params:query {
  ~include: variants,variants_options_table,brand,categories,collections,related_products,discounts,valid_discounts,expired_discounts,tags,product_type,tax_class,price_lists,price_breakdown
}

params:path {
  id-or-slug: 
}

headers {
  Accept: application/json
  Content-Type: application/json
  Locale: {{locale}}
  Country-ISO-2: {{countryIso2}}
}

body:json {
  {
    "name": "T-shirt v2",
    "status": "published",
    "category_ids": [1, 2],
    "collection_ids": [1, 2],
    "related_product_ids": [2, 3],
    "tag_ids": [1, 3],
    "metadata": {
      "titolo": "T-shirt v2",
      "autore": null,
      "descrizione": null,
      "robots": null,
      "open_graph_titolo": "T-shirt v2",
      "open_graph_url": null,
      "open_graph_immagine": null,
      "open_graph_tipo": null,
      "twitter_card": null,
      "twitter_site": null,
      "twitter_creator": null,
      "twitter_titolo": "T-shirt v2",
      "twitter_descrizione": null,
      "twitter_src": null
    },
    "inventory": {
      "stock": 0,
      "minimum_reorder_quantity": 5,
      "reorder_lead_days": 12,
      "manage_stock": false,
      "price": 34.99
    },
    "images": [
      {
        "id": "existing-image-id",
        "type": "thumb",
        "name": "T-shirt front",
        "alt": "Front view of the T-shirt",
        "sort_order": 1
      }
    ]
  }
}

docs {
  summary:
  - Update products

  endpoint:
  - method: PATCH
  - path: /products/:id-or-slug

  query params:
  - include (string|array): Optional includes: variants, variants_options_table, brand, categories, collections, related_products, discounts, valid_discounts, expired_discounts, tags, product_type, tax_class, price_breakdown, price_lists (if enabled).

  path params:
  - id-or-slug: Use a canonical positive integer for ID lookup, or any slug. Leading-zero or mixed values (for example `001` or `01-slug`) resolve as slugs.

  body:
  - JSON payload.
  - Available fields:
  - parent_id
  - brand_id
  - product_type_id
  - tax_class_id
  - name
  - slug
  - status
  - active
  - new
  - highlighted
  - sku
  - ean
  - visible_from
  - visible_until
  - description
  - description_short
  - images (array)
  - images.*.id
  - images.*.file
  - images.*.alt
  - images.*.name
  - images.*.mimetype
  - images.*.sort_order
  - images.*.type (nullable, thumb|cover)
  - files (array)
  - files.*.id
  - files.*.file
  - files.*.alt
  - files.*.name
  - files.*.mimetype
  - files.*.sort_order
  - files.*.active
  - measuring_unit
  - qty_for_unit
  - length
  - width
  - height
  - weight
  - metadata (array)
  - category_ids (array)
  - category_ids.*
  - collection_ids (array)
  - collection_ids.*
  - Note: newly attached collection_ids receive the collection's current max product sort_order plus one; existing collection-product sort_order values are preserved.
  - related_product_ids (array)
  - related_product_ids.*
  - tag_ids (array)
  - tag_ids.*
  - inventory (object)
  - inventory.currency_id
  - inventory.stock
  - inventory.stock_reserved
  - inventory.stock_min
  - inventory.minimum_reorder_quantity
  - inventory.reorder_lead_days
  - inventory.manage_stock
  - inventory.price
  - inventory.price_includes_tax
  - inventory.purchase_price
  - Note: price_calculated.price_final includes tax when the selected price does not include tax, using the country header rate or configured default tax rate.
  - {locale}.name / name:{locale}
  - {locale}.slug / slug:{locale}
  - {locale}.description / description:{locale}
  - {locale}.description_short / description_short:{locale}
  - Slug fields are accepted only when venditio.slugs.editable_via_api (or the product override) is true; disabled input returns 422.
  - Omitted slugs are generated on create; on update, omitted slugs follow venditio.slugs.regenerate_on_update.
  - Note: file uploads require multipart/form-data.
  - Note: if `mimetype` is omitted, the backend fills it from the uploaded file.
  - Note: product images follow the catalog image shape used by brands, categories, and collections.
  - Note: only one `thumb` and one `cover` are allowed. `type=null` can be repeated for generic images.
  - Note: image metadata updates for variant-option images are propagated to matching image copies with the same source path.
  - Note: if `id` is provided for files, the item updates an existing media entry and `file` must be omitted.
}
