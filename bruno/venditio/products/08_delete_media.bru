meta {
  name: Delete product file media
  type: http
  seq: 8
}

delete {
  url: {{baseUrl}}/products/:id-or-slug/media/:media-id
  body: none
  auth: inherit
}

params:path {
  id-or-slug: 
  media-id: 
}

headers {
  Accept: application/json
  Locale: {{locale}}
}

docs {
  summary:
  - Delete a product file by its unique backend-generated media id.

  endpoint:
  - method: DELETE
  - path: /products/:id-or-slug/media/:media-id

  path params:
  - id-or-slug: Use a canonical positive integer product ID, or any product slug. Leading-zero or mixed values (for example `001` or `01-slug`) resolve as slugs.
  - media-id: Unique media id returned in the product `files` array.

  behavior:
  - Removes the matching entry from the product `files` collection.
  - Product images should use `DELETE /products/:id-or-slug/images/:image-id`; this legacy endpoint still accepts image ids for compatibility.
  - Returns `204 No Content` on success.
  - File filesystem deletion is controlled by `VENDITIO_PRODUCT_MEDIA_DELETE_FILES_FROM_FILESYSTEM`.
}
