meta {
  name: Delete product_categories
  type: http
  seq: 10
}

delete {
  url: {{baseUrl}}/product_categories/:id-or-slug
  body: none
  auth: inherit
}

params:query {
  ~force: 0
  ~delete_children: 0
}

params:path {
  id-or-slug: 
}

headers {
  Accept: application/json
  Content-Type: application/json
  Locale: {{locale}}
}

docs {
  summary:
  - Delete product_categories

  endpoint:
  - method: DELETE
  - path: /product_categories/:id-or-slug

  query params:
  - force (boolean): Optional. When true, deletes even if products are connected and clears related product/tag pivot rows.
  - delete_children (boolean): Optional. When true, recursively deletes every child category below the target.
  - Without force, deleting a product category with connected products returns a validation error on `products`.
  - By default, deleting a parent product category preserves direct child categories, moves them to the deleted category's parent, and rebuilds their tree paths.

  path params:
  - id-or-slug: Use a canonical positive integer for ID lookup, or any slug. Leading-zero or mixed values (for example `001` or `01-slug`) resolve as slugs.

  body:
  - none
}
